{
  "rules": [
    { "kind": "move", "for": { "has": ["position", "velocity"] } },

    { "kind": "collide", "a": { "has": ["keys"] }, "b": { "has": ["solid"] },
      "effects": { "a": [["bounce"], ["set", "velocity", [0, 0]]] } },

    { "kind": "collide", "a": { "has": ["ball"] }, "b": { "has": ["solid"], "without": ["keys"] },
      "effects": { "a": [["bounce"]] },
      "do": [["play_sound", "bounce"]] },

    { "kind": "collide", "a": { "has": ["ball"] }, "b": { "has": ["keys"] },
      "effects": { "a": [["run", "paddle_bounce"]] },
      "do": [["play_sound", "bounce"]] },

    { "kind": "collide", "a": { "has": ["ball"] }, "b": { "has": ["brick"], "without": ["strong"] },
      "effects": { "a": [["bounce"]], "b": [["delete"]] },
      "do": [["add", "score", 10], ["play_sound", "brick"]] },

    { "kind": "collide", "a": { "has": ["ball"] }, "b": { "has": ["brick", "strong"] },
      "effects": { "a": [["bounce"]] },
      "do": [["run", "strong_brick_hit"]] },

    { "kind": "delete", "for": { "has": ["ball"] },
      "when": { "fewer_than": { "count": 1, "of": { "has": ["brick"] } } },
      "do": [["end_game", "win"], ["play_sound", "win"]] },

    { "kind": "delete", "for": { "has": ["ball"] }, "when": "outside_scene",
      "do": [["end_game", "loss"], ["play_sound", "lose"]] }
  ]
}
