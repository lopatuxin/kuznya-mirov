{
  "rules": [
    { "kind": "check", "for": { "has": ["hero"] },
      "do": [["run", "hero_pre_walk"]] },

    { "kind": "walk", "for": { "has": ["hero"] }, "avoid": { "has": ["obstacle"] } },

    { "kind": "check", "for": { "has": ["hero"] },
      "do": [["run", "update_game"]] },

    { "kind": "check", "for": { "has": ["marker"] }, "when": ["opacity", ">", 0],
      "do": [["add", "opacity", -0.05]] }
  ]
}
