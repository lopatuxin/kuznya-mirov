        { "kind": "label", "offset": [12, 5], "size": [386, 24], "text": "{mark} {name}", "font": "ui", "font_size": 17, "color": "#f1ede4" },
        { "kind": "label", "offset": [12, 29], "size": [386, 18], "text": "{cost_text}", "font": "ui", "font_size": 13, "color": "#f0c27a" },
        { "kind": "label", "offset": [12, 48], "size": [386, 18], "text": "{effect_text}", "font": "ui", "font_size": 12, "color": "#a9b6bd" }
      ] },
      { "kind": "button", "anchor": "right", "offset": [240, 232], "size": [196, 40], "text": "Починить", "font": "ui", "font_size": 16, "text_color": "#ffffff", "color": "#3a434c", "color_hover": "#4a545e", "color_pressed": "#2b3239", "on_click": ["run", "repair"], "for": { "has": ["game", "tuning"] } },
      { "kind": "button", "anchor": "right", "offset": [36, 232], "size": [196, 40], "text": "Готово (T)", "font": "ui", "font_size": 16, "text_color": "#ffffff", "color": "#2f7a55", "color_hover": "#3a9467", "color_pressed": "#255f43", "on_click": ["run", "finish_tuning"], "for": { "has": ["game", "tuning"] } },
      { "kind": "label", "anchor": "right", "offset": [36, 284], "size": [400, 40], "wrap": true, "text": "{tune_text}", "font": "ui", "font_size": 13, "color": "#f0c27a", "for": { "has": ["game", "tuning"] } }
    ] },

    { "name": "pause", "world_runs": false, "keys": { "Escape": ["resume"] }, "elements": [
      { "kind": "panel", "anchor": "center", "offset": [0, 0], "size": [420, 220], "color": "#10232dee" },
