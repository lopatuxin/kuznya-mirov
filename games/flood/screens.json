      { "kind": "button", "anchor": "center", "offset": [-96, 40], "size": [170, 48], "text": "Продолжить", "font": "ui", "font_size": 18, "text_color": "#ffffff", "color": "#2f7a55", "color_hover": "#3a9467", "color_pressed": "#255f43", "on_click": ["resume"] },
      { "kind": "button", "anchor": "center", "offset": [96, 40], "size": [170, 48], "text": "В меню", "font": "ui", "font_size": 18, "text_color": "#ffffff", "color": "#3a434c", "color_hover": "#4a545e", "color_pressed": "#2b3239", "on_click": ["quit"] }
    ] },

    { "name": "sunk", "world_runs": false, "elements": [
      { "kind": "panel", "anchor": "center", "offset": [0, 0], "size": [520, 260], "color": "#10232dee" },
      { "kind": "label", "anchor": "center", "offset": [0, -76], "size": [480, 44], "text": "Плот потоплен", "font": "ui", "font_size": 30, "color": "#f1ede4", "align": "center" },
      { "kind": "label", "anchor": "center", "offset": [0, -16], "size": [470, 60], "wrap": true, "text": "{game.result_text}", "font": "ui", "font_size": 16, "color": "#b9c7cf", "align": "center" },
      { "kind": "button", "anchor": "center", "offset": [-96, 70], "size": [170, 48], "text": "Ещё раз", "font": "ui", "font_size": 18, "text_color": "#ffffff", "color": "#2f7a55", "color_hover": "#3a9467", "color_pressed": "#255f43", "on_click": ["new_game", "game"] },
      { "kind": "button", "anchor": "center", "offset": [96, 70], "size": [170, 48], "text": "В меню", "font": "ui", "font_size": 18, "text_color": "#ffffff", "color": "#3a434c", "color_hover": "#4a545e", "color_pressed": "#2b3239", "on_click": ["quit"] }
    ] }
  ],
  "world_elements": [
    { "kind": "bar", "for": { "has": ["cell", "damaged"] }, "anchor": "top", "offset": [0, -0.15], "size": [0.8, 0.12], "value": "hp", "max": "max_hp", "color": "#e0533f", "back_color": "#000000aa" },
