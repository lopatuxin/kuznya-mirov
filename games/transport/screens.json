    { "kind": "label", "for": { "has": ["car"] }, "anchor": "top", "offset": [0, -0.7], "size": [7, 0.8], "text": "{name}{selected_mark}", "font": "ui", "font_size": 0.6, "align": "center", "color": "#ffd28a" },
    { "kind": "label", "for": { "has": ["car", "working"] }, "anchor": "top", "offset": [0, -1.35], "size": [7, 0.8], "text": "{work_text}", "font": "ui", "font_size": 0.6, "align": "center", "color": "#ffffff" },
    { "kind": "bar", "for": { "has": ["car", "working"] }, "anchor": "top", "offset": [0, -0.28], "size": [1.8, 0.22], "value": "work_done", "max": "work_total", "color": "#6fd08a", "back_color": "#000000aa" }
  ]
}
